# Local SQLite development database used by the application.
DATABASE_URL="file:./dev.db"

# Keep Prisma CLI schema work on the local SQLite database.
LOCAL_DATABASE_URL="file:./dev.db"

# Production only: use a hosted Turso/libSQL database instead of a local file.
# DATABASE_URL="libsql://<database>.turso.io"
# TURSO_AUTH_TOKEN="replace-with-your-Turso-auth-token"

# Generate a unique high-entropy value for each environment.
NEXTAUTH_SECRET="replace-with-a-unique-secret"

# Local: http://localhost:3000. Production: your canonical https URL.
NEXTAUTH_URL="http://localhost:3000"
